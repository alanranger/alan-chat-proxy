{
  "headers": [
    {
      "source": "/bulk-simple.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/db-maintenance",
      "schedule": "0 0 * * *"
    }
  ],
  "version": 2,
  "functions": {
    "api/csv-import.js": {
      "maxDuration": 120
    },
    "api/ingest.js": {
      "maxDuration": 60
    },
    "api/tools.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 300
    },
    "api/jobs/db-maintenance.js": {
      "maxDuration": 300
    }
  }
}


